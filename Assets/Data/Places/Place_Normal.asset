  - interactionId: clerk
    label: "\uC810\uC6D0\uACFC \uB300\uD654"
    type: 1
    resultText: 
    talk:
      npc: {fileID: 11400000, guid: f62d97600fab7af4791503c5c7d20c80, type: 2}
      firstLine: "\"\uC624\uB298\uC740 \uC870\uC6A9\uD558\uB124\uC694.\""
      choices:
      - text: "A. \uC694\uC998 \uC774\uC0C1\uD55C \uC77C \uC5C6\uC5C8\uC5B4\uC694?"
        result: "\"\uB531\uD788\uC694. \uC544, \uBC24\uB9C8\uB2E4 \uB0C9\uC7A5\uACE0
          \uBB38\uC774 \uD63C\uC790 \uC5F4\uB9AC\uAE34 \uD574\uC694.\""
      - text: "B. \uADF8\uB0E5 \uB458\uB7EC\uBCFC\uAC8C\uC694."
        result: "\uC810\uC6D0\uC740 \uACE0\uAC1C\uB97C \uB044\uB355\uC774\uACE0 \uACC4\uC0B0\uB300
          \uC815\uB9AC\uB97C \uACC4\uC18D\uD588\uB2E4."
      repeatLine: "\"\uB610 \uC624\uC168\uB124\uC694. \uD544\uC694\uD55C \uAC8C \uC788\uC73C\uBA74
        \uB9D0\uC500\uD558\uC138\uC694.\""
  - interactionId: suspicious
    label: "\uC218\uC0C1\uD55C \uC0AC\uB78C \uC870\uC0AC"
    type: 0
    resultText: "\uD2B9\uBCC4\uD788 \uC218\uC0C1\uD55C \uC0AC\uB78C\uC740 \uC5C6\uB2E4."
