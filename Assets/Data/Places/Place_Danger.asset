    talk:
      npc: {fileID: 11400000, guid: f62d97600fab7af4791503c5c7d20c80, type: 2}
      firstLine: "\uC810\uC6D0\uC740 \uAC81\uC5D0 \uC9C8\uB824 \uB9D0\uC744 \uC787\uC9C0
