  - interactionId: clerk
    label: "\uC810\uC6D0\uACFC \uB300\uD654"
    type: 1
    resultText: 
    talk:
      npc: {fileID: 11400000, guid: f62d97600fab7af4791503c5c7d20c80, type: 2}
      firstLine: "\"\uC694\uC6D0\uB2D8, \uC5EC\uAE30\uC120 \uC548\uC2EC\uD558\uACE0
        \uC26C\uC138\uC694.\""
      choices:
      - text: "A. \uC274 \uACF3\uC774 \uC788\uB098\uC694?"
        result: "\uC810\uC6D0: \"\uC548\uCABD \uD734\uAC8C\uC2E4\uC744 \uC4F0\uC138\uC694.
          \uC694\uC6D0\uB2D8\uB4E4 \uC804\uC6A9\uC774\uC5D0\uC694.\""
      - text: "B. \uBCF4\uAE09\uD488\uC744 \uD655\uC778\uD560\uAC8C\uC694."
        result: "\uC810\uC6D0\uC774 \uBCF4\uAE09\uD488 \uBAA9\uB85D\uC744 \uAC74\uB124\uC8FC\uC5C8\uB2E4."
      repeatLine: "\"\uD734\uAC8C\uC2E4\uC740 \uC5B8\uC81C\uB4E0 \uC4F0\uC154\uB3C4
        \uB3FC\uC694, \uC694\uC6D0\uB2D8.\""
  - interactionId: suspicious
    label: "\uC218\uC0C1\uD55C \uC0AC\uB78C \uC870\uC0AC"
