  m_Name: Place_Special
  m_EditorClassIdentifier: 
  locationId: special
  placeName: "\uD2B9\uBCC4 \uC9C0\uC5ED"
  placeType: 3
  description: "\uC77C\uBC18\uC801\uC778 \uBC29\uBC95\uC73C\uB85C\uB294 \uBC1C\uACAC\uD558\uAE30
    \uC5B4\uB824\uC6B4 \uC9C0\uC5ED\uC774\uB2E4."
  interiorBackground: {fileID: 0}
  interactions:
  - interactionId: shelf
    label: "\uC9C4\uC5F4\uB300 \uC870\uC0AC"
    type: 0
    resultText: "\uC874\uC7AC\uD558\uC9C0 \uC54A\uB294 \uC0C1\uD45C\uC758 \uBB3C\uAC74\uC774
      \uB193\uC5EC \uC788\uB2E4."
    talk:
      npc: {fileID: 0}
      firstLine: "[\uB300\uC0AC \uBBF8\uC815]"
      choices: []
      repeatLine: "[\uC7AC\uBC29\uBB38 \uB300\uC0AC \uBBF8\uC815]"
  - interactionId: clerk
    label: "\uC810\uC6D0\uACFC \uB300\uD654"
    type: 1
    resultText: 
    talk:
      npc: {fileID: 11400000, guid: f62d97600fab7af4791503c5c7d20c80, type: 2}
      firstLine: "\uC810\uC6D0\uC758 \uC5BC\uAD74\uC774 \uC798 \uBCF4\uC774\uC9C0
        \uC54A\uB294\uB2E4."
      choices:
      - text: "A. \uB2F9\uC2E0\uC740 \uB204\uAD6C\uC8E0?"
        result: "\uC810\uC6D0: \"\uC800\uB294 \uCC98\uC74C\uBD80\uD130 \uC5EC\uAE30
          \uC788\uC5C8\uB294\uB370\uC694?\" \uC6C3\uC74C\uC18C\uB9AC\uAC00 \uACB9\uCCD0
          \uB4E4\uB838\uB2E4."
      - text: "B. ...\uC544\uBB34 \uB9D0\uB3C4 \uD558\uC9C0 \uC54A\uB294\uB2E4."
        result: "\uC810\uC6D0\uC740 \uACE0\uAC1C\uB97C \uAE30\uC6B8\uC778 \uCC44
          \uB2F9\uC2E0\uC744 \uB05D\uAE4C\uC9C0 \uBC14\uB77C\uBCF4\uC558\uB2E4."
      repeatLine: "\"\uC800\uB294 \uCC98\uC74C\uBD80\uD130 \uC5EC\uAE30 \uC788\uC5C8\uB294\uB370\uC694?\"
        \uC544\uAE4C\uC640 \uB611\uAC19\uC740 \uBAA9\uC18C\uB9AC\uB2E4."
  - interactionId: suspicious
    label: "\uC218\uC0C1\uD55C \uC0AC\uB78C \uC870\uC0AC"
    type: 0
    resultText: "\uADF8 \uC0AC\uB78C\uC740 \uB2F9\uC2E0\uC758 \uC774\uB984\uC744
      \uC54C\uACE0 \uC788\uC5C8\uB2E4."
    talk:
      npc: {fileID: 0}
      firstLine: "[\uB300\uC0AC \uBBF8\uC815]"
      choices: []
      repeatLine: "[\uC7AC\uBC29\uBB38 \uB300\uC0AC \uBBF8\uC815]"
